# Database URL (SQLite default for MVP, can swap to PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./agriproof.db

# Planet Insights Platform API Credentials
PLANET_USER_ID=
PLANET_API_KEY=
PLANET_BASE_URL=https://api.planet.com/data/v1

# Sentinel Hub API Credentials (Optional)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_INSTANCE_ID=

# Open-Meteo Base URL (Free, no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Circuits Directory Path (relative to backend root)
CIRCUITS_DIR=../circuits

# Application Environment
APP_ENV=development

# CORS Allowed Origins (JSON Array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
